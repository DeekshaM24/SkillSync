NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never expose this key through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Keep both values private. The institution ID is printed by npm run seed.
PLACEMENT_OFFICER_INSTITUTION_ID=
PLACEMENT_OFFICER_INSTITUTION_CODE=replace-with-a-long-random-secret
# Required only by the demo seed. Choose a temporary password of at least 12 characters.
SEED_DEMO_PASSWORD=
